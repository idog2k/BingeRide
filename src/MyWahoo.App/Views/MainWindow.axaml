<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyWahoo.App.ViewModels"
        xmlns:c="using:MyWahoo.App.Controls"
        xmlns:svc="using:MyWahoo.App.Services"
        xmlns:dev="using:MyWahoo.Core.Devices"
        xmlns:v="using:MyWahoo.App.Views"
        x:Class="MyWahoo.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MyWahoo · KICKR control"
        Icon="avares://MyWahoo.App/Assets/app.ico"
        Width="1200" Height="780" MinWidth="1120" MinHeight="620"
        Background="{StaticResource BgBrush}"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header: mode switch + device status -->
    <Border Grid.Row="0" Padding="16,10" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="avares://MyWahoo.App/Assets/logo-64.png" Width="26" Height="26" VerticalAlignment="Center" />
            <TextBlock Text="MyWahoo" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
          <Border Classes="pill" Background="{Binding ModeBrush}" IsVisible="{Binding !IsWorkoutMode}">
            <TextBlock Text="{Binding ModeLabel}" FontSize="11" FontWeight="Bold" Foreground="#0B0D12" />
          </Border>
        </StackPanel>

        <!-- Riding on your own: how the trainer behaves -->
        <Border Grid.Column="1" Margin="20,0,0,0" Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="4"
                IsVisible="{Binding !IsWorkoutMode}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="mode" Classes.active="{Binding IsErgMode}" Content="ERG"
                    Command="{Binding SetModeCommand}" CommandParameter="Erg"
                    ToolTip.Tip="Trainer holds a power target" />
            <Button Classes="mode" Classes.active="{Binding IsSlopeMode}" Content="Slope"
                    Command="{Binding SetModeCommand}" CommandParameter="Slope"
                    ToolTip.Tip="Simulated grade + virtual gears" />
            <Button Classes="mode" Classes.active="{Binding IsFreeMode}" Content="Free"
                    Command="{Binding SetModeCommand}" CommandParameter="Free"
                    ToolTip.Tip="Flat road, you just shift gears" />
          </StackPanel>
        </Border>

        <!-- During a workout the workout drives the trainer: show it instead of the mode switch -->
        <Border Grid.Column="1" Margin="14,0,8,0" Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12,4,4,4"
                BorderBrush="{Binding ModeBrush}" BorderThickness="1" IsVisible="{Binding IsWorkoutMode}"
                ToolTip.Tip="{Binding ModeLabel}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" Foreground="{Binding ModeBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding WorkoutBannerText}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="280" />
            <Button Command="{Binding StopWorkoutCommand}" Padding="10,4" ToolTip.Tip="Stop the workout and go back to riding on your own (the ride keeps recording)">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconStop}" Width="10" Height="10" />
                <TextBlock Text="End workout" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- Device chips: green = connected, orange = connecting / Click v2 "−" locked, grey = not connected -->
          <Border Classes="chip" ToolTip.Tip="{Binding TrainerStatus}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="9" Height="9" Fill="{Binding TrainerChipBrush}" />
              <TextBlock Text="{Binding TrainerChipText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TrainerChipBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="chip" ToolTip.Tip="{Binding ClickStatus}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="9" Height="9" Fill="{Binding ClickChipBrush}" />
              <TextBlock Text="{Binding ClickChipText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ClickChipBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="chip" ToolTip.Tip="{Binding HeartRateStatus}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="♥" FontSize="12" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HeartRateConnected}" />
              <TextBlock Text="♥" FontSize="12" Foreground="{StaticResource BadBrush}" IsVisible="{Binding HeartRateConnected}" />
              <TextBlock Text="{Binding HeartRateText}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <!-- Ride recording -->
          <Button IsVisible="{Binding IsRideIdle}" Command="{Binding StartRideCommand}" Background="#E5484D" Margin="8,0,0,0"
                  ToolTip.Tip="Start recording a ride (Space). Totals and the .fit file only count while recording.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" Foreground="White" />
              <TextBlock Text="Start ride" Foreground="White" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Border IsVisible="{Binding IsRideActive}" Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="10,2,4,2" Margin="4,0,0,0"
                  ToolTip.Tip="Recording">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="9" Height="9" Fill="#E5484D" IsVisible="{Binding IsRecording}" VerticalAlignment="Center" />
              <TextBlock Text="PAUSED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" IsVisible="{Binding IsRidePaused}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RideTimeText}" FontWeight="SemiBold" FontFeatures="+tnum" VerticalAlignment="Center" MinWidth="44" />
              <Button Classes="icon" Command="{Binding TogglePauseCommand}" ToolTip.Tip="Pause / resume (Space)">
                <Panel>
                  <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding IsRecording}" />
                  <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding IsRidePaused}" />
                </Panel>
              </Button>
              <Button Command="{Binding FinishRideCommand}" Padding="10,4" ToolTip.Tip="Finish and save the ride as a .fit file">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" />
                  <TextBlock Text="Finish" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Button Command="{Binding ToggleCompactCommand}" Background="{StaticResource AccentBrush}" Foreground="#0B0D12"
                  ToolTip.Tip="Compact always-on-top overlay for Netflix (Ctrl+Alt+K)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconOverlay}" Width="14" Height="14" Foreground="#0B0D12" />
              <TextBlock Text="Overlay" Foreground="#0B0D12" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Notice banner (new workout from Claude, paste results, errors) -->
    <Border Grid.Row="1" IsVisible="{Binding HasNotice}" Background="#1A2B45" Padding="16,8"
            BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Margin="8,0,0,0" Content="Start now" IsVisible="{Binding NoticeEntry, Converter={x:Static ObjectConverters.IsNotNull}}"
                Command="{Binding StartNoticeWorkoutCommand}" Background="{StaticResource AccentBrush}" Foreground="#0B0D12" />
        <Button Grid.Column="2" Classes="icon" Margin="4,0,0,0" Command="{Binding DismissNoticeCommand}" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,16,400" Margin="16">

      <!-- Ride panel -->
      <Grid RowDefinitions="Auto,10,Auto,10,*">
        <UniformGrid Columns="5">
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="POWER · 3S" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="metric" Text="{Binding PowerText}" />
                <TextBlock Classes="unit" Text="W" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="TARGET" />
              <TextBlock Classes="metric" Text="{Binding TargetText}" Foreground="{Binding ModeBrush}" FontSize="30" Margin="0,6,0,4" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="CADENCE" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="metric" Text="{Binding CadenceText}" />
                <TextBlock Classes="unit" Text="rpm" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="SPEED" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="metric" Text="{Binding SpeedText}" />
                <TextBlock Classes="unit" Text="km/h" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="label" Text="HEART RATE" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="metric" Text="{Binding HeartRateText}" />
                <TextBlock Classes="unit" Text="bpm" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="11" Text="{Binding HeartRateStatsText}" Margin="0,-4,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="6">
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="GEAR" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="metric-sm" Text="{Binding GearText}" />
                <TextBlock Classes="muted" Text="{Binding GearRatioText}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="GRADE" />
              <TextBlock Classes="metric-sm" Text="{Binding GradeText}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="DISTANCE" />
              <TextBlock Classes="metric-sm" Text="{Binding DistanceText}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="RIDE TIME" />
              <TextBlock Classes="metric-sm" Text="{Binding ElapsedText}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="AVG POWER" />
              <TextBlock Classes="metric-sm" Text="{Binding AvgPowerText}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="label" Text="WORK · KJ" />
              <TextBlock Classes="metric-sm" Text="{Binding KjText}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Control area: changes with the mode -->
        <Border Grid.Row="4" Classes="card" Padding="20,16">
          <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="{Binding ModeDetail}" TextWrapping="Wrap" />
              <Border IsVisible="{Binding HasCue}" Background="#1A2B45" CornerRadius="8" Padding="12,8" Margin="0,6,0,0">
                <TextBlock Text="{Binding CueText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              </Border>
            </StackPanel>

            <!-- Workout step -->
            <Grid Grid.Row="1" IsVisible="{Binding IsWorkoutMode}" RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding StepTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" Text="{Binding NextStepText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28">
                  <StackPanel HorizontalAlignment="Right">
                    <TextBlock Classes="label" Text="STEP TARGET" HorizontalAlignment="Right" />
                    <TextBlock Classes="metric" Text="{Binding StepTargetText}" Foreground="{Binding ModeBrush}" HorizontalAlignment="Right" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Right">
                    <TextBlock Classes="label" Text="STEP LEFT" HorizontalAlignment="Right" />
                    <TextBlock Classes="metric" Text="{Binding StepRemainingText}" HorizontalAlignment="Right" />
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="tool" Command="{Binding PreviousStepCommand}" ToolTip.Tip="Restart / previous step">
                    <PathIcon Data="{StaticResource IconPrev}" />
                  </Button>
                  <Button Classes="tool" Command="{Binding TogglePauseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconPause}" />
                      <TextBlock Text="{Binding PauseLabel}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="tool" Command="{Binding SkipStepCommand}" ToolTip.Tip="Skip step">
                    <PathIcon Data="{StaticResource IconNext}" />
                  </Button>
                  <Button Classes="tool" Command="{Binding StopWorkoutCommand}" ToolTip.Tip="End workout">
                    <PathIcon Data="{StaticResource IconStop}" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding WorkoutTimeText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowIntensityControls}">
                  <TextBlock Classes="label" Text="INTENSITY" VerticalAlignment="Center" />
                  <Button Classes="tool" Command="{Binding IntensityDownCommand}"><PathIcon Data="{StaticResource IconMinus}" /></Button>
                  <TextBlock Text="{Binding IntensityText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" />
                  <Button Classes="tool" Command="{Binding IntensityUpCommand}"><PathIcon Data="{StaticResource IconPlus}" /></Button>
                </StackPanel>
              </Grid>
              <c:WorkoutChart Grid.Row="2" Margin="0,14,0,0" MinHeight="90"
                              Workout="{Binding ActiveWorkout}" Ftp="{Binding Ftp}" Progress="{Binding WorkoutProgress}"
                              FoodMarkers="{Binding ActiveFoodMarkers}" />
            </Grid>

            <!-- Manual controls -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="48"
                        IsVisible="{Binding ShowManualControls}">
              <StackPanel IsVisible="{Binding ShowErgControls}" Spacing="8">
                <TextBlock Classes="label" Text="TARGET POWER" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <Button Classes="round" Command="{Binding ErgDownCommand}"><PathIcon Data="{StaticResource IconMinus}" /></Button>
                  <TextBlock Text="{Binding ErgWattsText}" FontSize="56" FontWeight="Bold" MinWidth="200" TextAlignment="Center" VerticalAlignment="Center" Foreground="DarkOrange" />
                  <Button Classes="round" Command="{Binding ErgUpCommand}"><PathIcon Data="{StaticResource IconPlus}" /></Button>
                </StackPanel>
              </StackPanel>
              <StackPanel IsVisible="{Binding ShowGradeControls}" Spacing="8">
                <TextBlock Classes="label" Text="GRADE" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <Button Classes="round" Command="{Binding GradeDownCommand}"><PathIcon Data="{StaticResource IconMinus}" /></Button>
                  <TextBlock Text="{Binding GradeText}" FontSize="56" FontWeight="Bold" MinWidth="170" TextAlignment="Center" VerticalAlignment="Center" Foreground="MediumSeaGreen" />
                  <Button Classes="round" Command="{Binding GradeUpCommand}"><PathIcon Data="{StaticResource IconPlus}" /></Button>
                </StackPanel>
              </StackPanel>
              <StackPanel IsVisible="{Binding ShowGearControls}" Spacing="8">
                <TextBlock Classes="label" Text="VIRTUAL GEAR" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <Button Classes="round" Command="{Binding GearDownCommand}"><PathIcon Data="{StaticResource IconMinus}" /></Button>
                  <StackPanel VerticalAlignment="Center" MinWidth="120">
                    <TextBlock Text="{Binding GearText}" FontSize="56" FontWeight="Bold" TextAlignment="Center" Foreground="MediumPurple" />
                    <TextBlock Classes="muted" Text="{Binding GearRatioText, StringFormat='ratio {0}'}" TextAlignment="Center" />
                  </StackPanel>
                  <Button Classes="round" Command="{Binding GearUpCommand}"><PathIcon Data="{StaticResource IconPlus}" /></Button>
                </StackPanel>
                <c:GearIndicator Gear="{Binding Gear}" Width="260" Height="44" Margin="0,8,0,0" />
              </StackPanel>
            </StackPanel>

            <!-- Food burned and distance travelled -->
            <StackPanel Grid.Row="2" Spacing="4" Margin="0,10,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowFood}">
                <TextBlock Classes="label" Text="BURNED" VerticalAlignment="Center" MinWidth="64" />
                <TextBlock Text="{Binding BurnedFoodText}" FontSize="22" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding KcalText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding NextFoodText}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowLandmarks}">
                <TextBlock Classes="label" Text="TRAVELLED" VerticalAlignment="Center" MinWidth="64" />
                <TextBlock Text="{Binding DistanceText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DistanceLandmarkText}" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>

            <!-- Gear controls during slope/free workout steps -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsWorkoutMode" />
                  <Binding Path="ShowGearControls" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <TextBlock Classes="label" Text="GEAR" VerticalAlignment="Center" />
              <Button Classes="tool" Command="{Binding GearDownCommand}"><PathIcon Data="{StaticResource IconMinus}" /></Button>
              <TextBlock Text="{Binding GearText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="30" TextAlignment="Center" />
              <Button Classes="tool" Command="{Binding GearUpCommand}"><PathIcon Data="{StaticResource IconPlus}" /></Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Side panel -->
      <Border Grid.Column="2" Classes="card" Padding="8">
        <TabControl Padding="6,4">
          <TabItem Header="Workouts" FontSize="15">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,8">
                <Button Classes="tool" Command="{Binding PasteWorkoutCommand}" ToolTip.Tip="Paste a workout copied from Claude (Ctrl+V)">
                  <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPaste}" /><TextBlock Text="Paste" /></StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding ImportFileCommand}" ToolTip.Tip=".json .zwo .erg .mrc .fit .txt .gpx .tcx (or drag files onto the window)">
                  <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconImport}" /><TextBlock Text="Import" /></StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding OpenWorkoutsFolderCommand}" ToolTip.Tip="{Binding WorkoutsFolder}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconFolder}" /><TextBlock Text="Folder" /></StackPanel>
                </Button>
              </StackPanel>

              <ListBox Grid.Row="1" ItemsSource="{Binding Workouts}" SelectedItem="{Binding SelectedWorkout}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:LibraryEntry">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis"
                                 Classes.error="{Binding HasError}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border Grid.Row="2" Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12" Margin="0,8,0,0"
                      IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding SelectedWorkout.Name, FallbackValue=''}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding SelectedSummary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" FontSize="12" MaxHeight="64" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding SelectedDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <c:WorkoutChart Height="84" Workout="{Binding SelectedWorkout.Workout, FallbackValue={x:Null}}" Ftp="{Binding Ftp}"
                                  FoodMarkers="{Binding SelectedFoodMarkers}" />
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{StaticResource AccentBrush}"
                          Command="{Binding StartWorkoutCommand}" CommandParameter="{Binding SelectedWorkout}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" Foreground="#0B0D12" />
                      <TextBlock Text="Start workout" Foreground="#0B0D12" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Devices" FontSize="15">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="0,6,0,0">
                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="TRAINER" />
                    <TextBlock Text="{Binding TrainerStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Demo trainer" Command="{Binding UseDemoTrainerCommand}" ToolTip.Tip="Simulated rider: try the app without the KICKR" />
                      <Button Content="Disconnect" Command="{Binding DisconnectTrainerCommand}" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Close Zwift and the Wahoo app first: the KICKR takes orders from one app at a time." />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="ZWIFT CLICK" />
                    <TextBlock Text="{Binding ClickStatus}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Click v2: the '−' puck goes silent after ~1 min unless the Zwift app unlocked it in the last ~24 h. B on the '+' puck also shifts down." />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="HEART RATE" />
                    <TextBlock Text="{Binding HeartRateStatus}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Garmin watch: hold LIGHT for the controls menu and choose Broadcast Heart Rate (or turn on Broadcast During Activity and start an Indoor Bike activity). Any Bluetooth chest strap works too. To switch sensors, press Connect on one below." />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="PHONE REMOTE" />
                    <TextBlock Text="{Binding RemoteStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Command="{Binding PairPhoneCommand}" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="📱 Pair a phone" Foreground="#0B0D12" FontWeight="SemiBold" />
                      </Button>
                      <Button Content="Turn off" Command="{Binding TurnOffRemoteCommand}" IsVisible="{Binding RemoteRunning}" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="The phone must be on the same Wi-Fi as this PC. The first time, Windows asks whether MyWahoo may use private networks: click Allow. The QR code works once and only for 5 minutes; only paired phones can see or control anything." />
                    <TextBlock Classes="label" Text="PAIRED PHONES" IsVisible="{Binding HasPairedPhones}" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding PairedPhones}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PairedPhoneRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" />
                              <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Forget" VerticalAlignment="Center"
                                    Command="{ReflectionBinding DataContext.ForgetPhoneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label" Text="NEARBY" Margin="2,4,0,0" />
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="✓ Connected" Foreground="{StaticResource GoodBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" IsVisible="{Binding IsConnected}" />
                        <Button Grid.Column="1" Content="Connect" VerticalAlignment="Center" IsVisible="{Binding CanConnect}"
                                Command="{ReflectionBinding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Device}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Rides" FontSize="15">
            <Grid RowDefinitions="Auto,Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,6">
                <Button Classes="tool" Command="{Binding OpenRidesFolderCommand}" ToolTip.Tip="Open the folder with the .fit files">
                  <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconFolder}" /><TextBlock Text="Rides folder" /></StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="6" Margin="2,0,0,8">
                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12,10" IsVisible="{Binding ShowLandmarks}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LifetimeText, StringFormat='🌍 {0}'}" FontWeight="Bold" FontSize="16" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding LifetimeFraction}" Height="8" CornerRadius="4" />
                    <TextBlock Text="{Binding LifetimeNextText}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Each finished ride is saved as a .fit file. Upload it at strava.com/upload, Garmin Connect (Import data) or intervals.icu." />
              </StackPanel>
              <ListBox Grid.Row="2" ItemsSource="{Binding RideEntries}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:RideEntry">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DateText}" FontSize="12" Classes="muted" />
                      <TextBlock Text="{Binding StatsText}" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding LandmarkText}" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{ReflectionBinding DataContext.ShowLandmarks, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                      <TextBlock Text="{Binding FoodText}" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{ReflectionBinding DataContext.ShowFood, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="Settings" FontSize="15">
            <ScrollViewer>
              <StackPanel Spacing="8" Margin="0,6,8,0">
                <TextBlock Classes="label" Text="RIDER" />
                <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="FTP (W)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding FtpSetting}" Minimum="50" Maximum="600" Increment="5" FormatString="0" />
                  <TextBlock Grid.Row="1" Text="Rider weight (kg)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RiderKgSetting}" Minimum="30" Maximum="200" Increment="0.5" FormatString="0.0" />
                  <TextBlock Grid.Row="2" Text="Bike weight (kg)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding BikeKgSetting}" Minimum="3" Maximum="30" Increment="0.5" FormatString="0.0" />
                </Grid>
                <CheckBox Content="Connect to a heart-rate sensor (strap or watch broadcast)" IsChecked="{Binding HeartRateEnabledSetting}" />

                <TextBlock Classes="label" Text="CONTROLS" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="ERG step (W)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding ErgStepSetting}" Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                  <TextBlock Grid.Row="1" Text="Grade step (%)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GradeStepSetting}" Minimum="0.1" Maximum="5" Increment="0.1" FormatString="0.0" />
                  <TextBlock Grid.Row="2" Text="Workout intensity step (%)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding IntensityStepSetting}" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
                  <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Pause workouts when I stop pedalling" IsChecked="{Binding AutoPauseSetting}" />
                </Grid>
                <CheckBox Content="Show the food I burn (🍕 = calories)" IsChecked="{Binding ShowFoodSetting}" />
                <CheckBox Content="Show distance as famous trips (⚓ Tel Aviv → Haifa, 🛣️ New York → LA…)" IsChecked="{Binding ShowLandmarksSetting}" />

                <TextBlock Classes="label" Text="OVERLAY" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,180" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Background opacity" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding OverlayOpacity}" />
                  <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                  <Slider Grid.Row="1" Grid.Column="1" Minimum="0.6" Maximum="2" Value="{Binding OverlayScale}" />
                  <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="Start in overlay mode" IsChecked="{Binding StartCompactSetting}" />
                </Grid>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Hotkeys: Ctrl+Alt+K overlay ↔ full window, Ctrl+Alt+L mouse click-through on/off." />
                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="10,8" Margin="0,4,0,0">
                  <v:OverlayFieldsEditor />
                </Border>

                <TextBlock Classes="label" Text="ZWIFT CLICK BUTTONS" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding ClickMappings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClickMappingItem">
                      <Grid ColumnDefinitions="*,180" Margin="0,2">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:MainViewModel.ClickActions}" SelectedItem="{Binding Action}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Up/Down: ERG watts in ERG, workout intensity in ERG steps, gears otherwise." />
                <CheckBox Content="Keep Click v2 '+' puck awake (reboots it after 55 s idle)" IsChecked="{Binding ClickIdleResetSetting}" />
                <CheckBox Content="Reboot a locked Click v2 '−' puck (2–3 s gaps)" IsChecked="{Binding ClickRebootLeftSetting}" />

                <TextBlock Classes="label" Text="TRAINER (ADVANCED)" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Control protocol" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{x:Static vm:MainViewModel.ControlPreferences}" SelectedItem="{Binding TrainerControlSetting}" />
                  <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Send ERG over FTMS (diagnostic)" IsChecked="{Binding ErgViaFtmsSetting}" />
                  <TextBlock Grid.Row="2" Text="Chainring (FTMS gear emulation)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ChainringSetting}" Minimum="20" Maximum="60" FormatString="0" />
                  <TextBlock Grid.Row="3" Text="Cog" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding CogSetting}" Minimum="10" Maximum="36" FormatString="0" />
                </Grid>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Protocol changes apply on the next trainer connection." />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Log" FontSize="15">
            <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" FontSize="12" />
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <!-- Device status bar -->
    <Border Grid.Row="3" Padding="16,6" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="22">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="8" Height="8" Fill="{StaticResource MutedBrush}" IsVisible="{Binding !TrainerConnected}" />
          <Ellipse Width="8" Height="8" Fill="{StaticResource GoodBrush}" IsVisible="{Binding TrainerConnected}" />
          <TextBlock Text="{Binding TrainerStatus}" FontSize="12" MaxWidth="420" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="8" Height="8" Fill="{StaticResource MutedBrush}" IsVisible="{Binding !ClickConnected}" />
          <Ellipse Width="8" Height="8" Fill="{StaticResource GoodBrush}" IsVisible="{Binding ClickConnected}" />
          <TextBlock Text="{Binding ClickStatus}" FontSize="12" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="♥" FontSize="12" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HeartRateConnected}" />
          <TextBlock Text="♥" FontSize="12" Foreground="{StaticResource BadBrush}" IsVisible="{Binding HeartRateConnected}" />
          <TextBlock Text="{Binding HeartRateStatus}" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Pairing pop-over: a big QR in the middle of the window -->
    <Border Grid.RowSpan="4" Background="#D9000000" IsVisible="{Binding IsPairing}">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MaxWidth="460">
        <StackPanel Spacing="12">
          <TextBlock Text="Pair your phone" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
          <Border Background="White" CornerRadius="14" Padding="12" HorizontalAlignment="Center">
            <Image Source="{Binding PairingQr}" Width="300" Height="300" />
          </Border>
          <StackPanel Spacing="4">
            <TextBlock TextWrapping="Wrap" Text="1. Open the iPhone Camera and point it at the code (same Wi-Fi as this PC)." />
            <TextBlock TextWrapping="Wrap" Text="2. Tap the link that appears: MyWahoo opens in Safari." />
            <TextBlock TextWrapping="Wrap" Text="3. In Safari: Share → Add to Home Screen, for an app icon." />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" Text="{Binding PairingExpiresText}" HorizontalAlignment="Center" />
          <Button Content="Cancel" Command="{Binding CancelPairingCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
