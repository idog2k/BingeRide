<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyWahoo.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="PanelBrush" Color="#141821" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#1B2030" />
    <SolidColorBrush x:Key="LineBrush" Color="#262C3B" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8ECF4" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A93A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3BA7FF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#39D98A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB84D" />
    <SolidColorBrush x:Key="BadBrush" Color="#FF4D6A" />

    <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPause">M6,5 H10 V19 H6 Z M14,5 H18 V19 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="IconNext">M5,5 L14,12 L5,19 Z M15,5 H18.5 V19 H15 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPrev">M19,5 L10,12 L19,19 Z M5.5,5 H9 V19 H5.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M6,6 H18 V18 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M10.8,4 H13.2 V10.8 H20 V13.2 H13.2 V20 H10.8 V13.2 H4 V10.8 H10.8 Z</StreamGeometry>
    <StreamGeometry x:Key="IconMinus">M4,10.8 H20 V13.2 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconExpand">M4,4 H10 V6.2 H6.2 V10 H4 Z M14,4 H20 V10 H17.8 V6.2 H14 Z M4,14 H6.2 V17.8 H10 V20 H4 Z M17.8,14 H20 V20 H14 V17.8 H17.8 Z</StreamGeometry>
    <StreamGeometry x:Key="IconOverlay">F0 M2,4 H22 V20 H2 Z M4,6 V18 H20 V6 Z M11,11 H18 V16 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPointer">M5,2 L19,13 L12.5,13.8 L16,21 L13.4,22.2 L10,15 L5,19.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSun">M12,7 A5,5 0 1 1 11.99,7 Z M11,1 H13 V4 H11 Z M11,20 H13 V23 H11 Z M1,11 H4 V13 H1 Z M20,11 H23 V13 H20 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPaste">F0 M9,2 H15 V4 H19 V22 H5 V4 H9 Z M7,6 V20 H17 V6 Z M9,9 H15 V11 H9 Z M9,13 H15 V15 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M2,5 H9 L11,7 H22 V19 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconImport">M10.8,3 H13.2 V12.5 L16.6,9.1 L18.3,10.8 L12,17.1 L5.7,10.8 L7.4,9.1 L10.8,12.5 Z M4,19 H20 V21.4 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M5.6,4.2 L12,10.6 L18.4,4.2 L19.8,5.6 L13.4,12 L19.8,18.4 L18.4,19.8 L12,13.4 L5.6,19.8 L4.2,18.4 L10.6,12 L4.2,5.6 Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="36" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.metric-sm">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.unit">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="3,0,0,7" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.round">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    </Style>
    <Style Selector="Button.round PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.mode">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.mode.active">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#0B0D12" />
    </Style>
    <Style Selector="Button.mode.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#0B0D12" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </Application.Styles>
</Application>
