<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <!-- Kestrel for the phone web remote. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BingeRide.Core/BingeRide.Core.csproj" />
    <ProjectReference Include="../BingeRide.Workouts/BingeRide.Workouts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Web/**" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Example workouts copied into a brand-new library folder on first run. -->
    <EmbeddedResource Include="../../samples/workouts/*" LogicalName="samples/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BingeRide.App.Tests" />
  </ItemGroup>
</Project>
