<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BingeRide.App.ViewModels"
        xmlns:c="using:BingeRide.App.Controls"
        x:Class="BingeRide.App.Views.RideDetailWindow"
        x:DataType="vm:RideDetailViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://BingeRide.App/Assets/app.ico"
        Width="1100" Height="740" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12,16,10">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding DateText}" Classes="muted" FontSize="12" />
    </StackPanel>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" Margin="0,10,0,4">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StatTile">
          <Border Classes="chip" Margin="0,0,8,8" Padding="12,6" MinWidth="92">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding Label}" />
              <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" FontFeatures="+tnum" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="2" Classes="card" Padding="8,8,8,6">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,6" MinHeight="30">
          <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" FontWeight="SemiBold" FontFeatures="+tnum" />
          <Button Grid.Column="1" Content="Show whole ride" Command="{Binding ResetZoomCommand}" IsVisible="{Binding IsZoomed}"
                  Padding="10,4" ToolTip.Tip="Zoom back out (or double-click the chart)" />
        </Grid>
        <c:RideChart Grid.Row="1" x:Name="Chart" Track="{Binding Track}" Ftp="{Binding Ftp}"
                     ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}" IsVisible="{Binding HasTrack}" />
        <TextBlock Grid.Row="1" Text="{Binding Status}" IsVisible="{Binding !HasTrack}" Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
        <ScrollBar Grid.Row="2" Orientation="Horizontal" AllowAutoHide="False" Margin="44,6,14,0"
                   Minimum="0" Maximum="{Binding ScrollMax}" ViewportSize="{Binding ViewSpan}" Value="{Binding ScrollValue}"
                   IsVisible="{Binding IsZoomed}" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Classes="muted" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
               Text="Hover for the values at any moment · drag across the chart to zoom in · mouse wheel zooms, Shift+wheel scrolls · double-click shows the whole ride" />
  </Grid>
</Window>
